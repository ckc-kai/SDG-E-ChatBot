POSTGRES_PASSWORD=change-me
ANTHROPIC_API_KEY=

# Task 3 Amazon Bedrock (non-secret settings)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=500
BEDROCK_TEMPERATURE=0
# Set this to the documented window for the selected Bedrock model ID.
BEDROCK_CONTEXT_TOKENS=4096

# Task 3 provider selection. Both planners run on the answering provider:
# a local 9B planner truncated its plan JSON at 500 tokens, which parsed as a
# planner failure and degraded every multi-part question to one broad step.
# TASK3_PLANNER_MODEL must name a model of TASK3_PLANNER_PROVIDER -- leaving an
# Ollama model name here while switching the provider to deepseek sends an
# unknown model id and every planner call fails with HTTP 400.
TASK3_PROVIDER=deepseek
TASK3_PLANNER_PROVIDER=deepseek
TASK3_PLANNER_MODEL=deepseek-v4-flash
TASK3_PLANNER_MAX_TOKENS=1500
# The Excel DSL planner. Unset, it falls back to Groq when GROQ_API_KEY is
# present and to Ollama otherwise, which silently changes the planner between
# machines; set it explicitly so runs stay comparable.
EXCEL_PLANNER_PROVIDER=deepseek
EXCEL_PLANNER_MAX_TOKENS=1500
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_MAX_TOKENS=500
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_TOKEN_SAFETY_FACTOR=1.25
OLLAMA_KEEP_ALIVE=30m
MODEL_WARMUP_ENABLED=true

# Task 3 Groq alternative. Keep the account on Groq's Free plan; never commit
# the key. Select with TASK3_PROVIDER=groq. Rate-limit errors are not retried.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_TOKENS=1500
GROQ_TEMPERATURE=0
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=120
GROQ_CONTEXT_TOKENS=131072
# Operational cap for the Free-plan token-per-minute limit, not the model window.
# First request only; later requests use discovered model and account limits.
GROQ_PROMPT_TOKEN_BUDGET=6500
# Maximum user-request wait; the actual wait comes from Groq's reset header.
GROQ_MAX_RATE_LIMIT_WAIT_SECONDS=15
GROQ_TOKEN_SAFETY_FACTOR=1.2

# Task 3 DeepSeek alternative. Select with TASK3_PROVIDER=deepseek. The
# comparison defaults keep the same prompt/output budgets as the Groq run.
# Never commit the API key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=1500
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_CONTEXT_TOKENS=1000000
DEEPSEEK_MODEL_MAX_OUTPUT_TOKENS=384000
# Ceiling for the workbook lane. 6500 was carried over from Groq's free-plan
# rate limit and starved answers on a model with a 1M window: retrieved rows
# filled the prompt and the narrative evidence never reached the model.
DEEPSEEK_PROMPT_TOKEN_BUDGET=60000
DEEPSEEK_TOKEN_SAFETY_FACTOR=1.2
# Answers with no executed workbook rows behind them use this tighter budget
# instead of the ceiling above. Narrative questions measurably degrade when the
# prompt is flooded, while a cumulative-target question needs every row it
# asked for, so the two lanes do not share one number.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SDGE_PDF_PROMPT_TOKEN_BUDGET=25000
